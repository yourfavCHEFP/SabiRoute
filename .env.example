# ============================================================
# SabiRoute Environment Configuration
# ============================================================
#
# IMPORTANT:
# Copy this file to .env before running locally:
#
#     cp .env.example .env
#
# NEVER commit .env to Git.
# ============================================================


# ------------------------------------------------------------
# SabiRoute / LiteLLM Gateway
# ------------------------------------------------------------

# Host port published for the LiteLLM proxy
LITELLM_PORT=4000

# LiteLLM master/admin key.
# Generate a strong value, for example:
#   openssl rand -hex 32
#
# The master key should use the "sk-" convention.
LITELLM_MASTER_KEY=sk-change-this-to-a-long-random-secret

# SabiRoute administrative bootstrap key. This is separate from client
# API keys and the LiteLLM master key; set a unique random value.
SABIROUTE_ADMIN_KEY=

# IMPORTANT:
# LiteLLM uses this to encrypt provider credentials stored in
# PostgreSQL. Generate it once and KEEP IT.
#
# Do not casually change this value after deployment.
LITELLM_SALT_KEY=sk-change-this-to-another-long-random-secret


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

POSTGRES_DB=sabiroute
POSTGRES_USER=sabiroute
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432

# Host-run SabiRoute uses the published local PostgreSQL port.
DATABASE_URL=postgresql://sabiroute:change-this-postgres-password@127.0.0.1:5432/sabiroute


# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-this-redis-password

REDIS_URL=redis://:change-this-redis-password@127.0.0.1:6379/0


# ============================================================
# PROVIDER API KEYS
# ============================================================

# ------------------------------------------------------------
# PRIMARY / CORE PROVIDERS
# ------------------------------------------------------------

OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHERAI_API_KEY=
DEEPINFRA_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=


# ------------------------------------------------------------
# ADDITIONAL PROVIDERS
# ------------------------------------------------------------

# Cloudflare Workers AI
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Hugging Face
HF_TOKEN=

# Cerebras
CEREBRAS_API_KEY=

# NVIDIA NIM
NVIDIA_NIM_API_KEY=

# Cohere
COHERE_API_KEY=

# Pollinations AI
POLLINATION_API_KEY=
POLLINATIONS_API_BASE=https://gen.pollinations.ai/v1

# Qoder — reserved for future integration
QODER_API_KEY=


# ============================================================
# APPLICATION SETTINGS
# ============================================================

SABIROUTE_ENV=development

LOG_LEVEL=INFO

# Enable structured JSON logs in production.
STRUCTURED_LOGGING=false


# ============================================================
# OPTIONAL OBSERVABILITY
# ============================================================

# Prometheus metrics can be added later.
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090


# ============================================================
# OPTIONAL SECURITY
# ============================================================

# Reserved legacy placeholder; current SabiRoute authentication uses
# SABIROUTE_ADMIN_KEY for administration and persisted client API keys.
SABIROUTE_INTERNAL_KEY=


# ============================================================
# LOCAL DEVELOPMENT
# ============================================================

# For host-run SabiRoute, keep DATABASE_URL and REDIS_URL on 127.0.0.1 as
# configured above. Compose overrides LiteLLM's addresses to postgres/redis.
